# Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
# Paste the generated value here. Do not reuse keys from older source code.
SECRET_KEY=
# Optional independent JWT key; otherwise SECRET_KEY is used.
JWT_SECRET_KEY=

# Local SQLite database, stored inside instance/.
DATABASE_URL=sqlite:///social_media.db
# MySQL example: mysql+pymysql://app_user:URL_ENCODED_PASSWORD@localhost:3306/social_media

# Required only for image uploads. Uploaded media must be publicly readable.
GCS_BUCKET_NAME=
# For local use only, if Application Default Credentials are not configured:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-the-project/service-account.json
PORT=5000
